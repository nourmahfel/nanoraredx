{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/nanoraredx/master/assets/schema_input.json",
    "title": "nf-core/nanoraredx pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample_id": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample ID must be provided and cannot contain spaces",
                "meta": ["id"],
                "description": "Unique sample identifier"
            },
            "ubam": {
                "anyOf": [
                    {
                        "type": "string",
                        "format": "directory-path",
                        "description": "Directory containing unaligned BAM files"
                    },
                    {
                        "type": "string",
                        "format": "file-path",
                        "pattern": "^\\S+\\.bam$",
                        "description": "Single unaligned BAM file"
                    },
                    {
                        "type": "string",
                        "maxLength": 0,
                        "description": "Empty string when not used"
                    }
                ],
                "description": "Directory containing unaligned BAM files OR single BAM file for this sample",
                "help_text": "Either a directory path containing unaligned BAM files OR a single .bam file path. Used when --align_with_bam is enabled."
            },
            "fastq": {
                "anyOf": [
                    {
                        "type": "string",
                        "format": "directory-path",
                        "description": "Directory containing unaligned BAM files"
                    },
                    {
                        "type": "string",
                        "format": "file-path",
                        "pattern": "^\\S+\\.fastq.gz$",
                        "description": "Single unaligned BAM file"
                    },
                    {
                        "type": "string",
                        "maxLength": 0,
                        "description": "Empty string when not used"
                    }
                ],
                "description": "Directory containing FASTQ files for this sample or a single FASTQ file",
                "help_text": "Directory path containing FASTQ files (.fastq.gz or .fq.gz). Used when --align_with_fastq is enabled."
            },
            "bam": {
                "anyOf": [
                    { "type": "string", "format": "file-path", "pattern": "^\\S+\\.bam$" },
                    { "type": "string", "maxLength": 0 }
                ],
                "description": "Path to pre-aligned BAM file",
                "help_text": "Full path to a pre-aligned BAM file. The corresponding .bai index file must exist in the same directory. Used when neither --align_with_fastq nor --align_with_bam are enabled."
            },
            "methyl_bam": {
                "anyOf": [
                    { "type": "string", "format": "file-path", "pattern": "^\\S+\\.bam$" },
                    { "type": "string", "maxLength": 0 }
                ],
                "description": "Path to BAM file with methylation information",
                "help_text": "Full path to a BAM file containing methylation calls. Required when --methyl is enabled and --align_with_bam is not used. The corresponding .bai index file must exist in the same directory."
            },
            "hpo_terms": {
                "anyOf": [
                    { "type": "string", "pattern": "^HP:\\d{7}(;HP:\\d{7})*$" },
                    { "type": "string", "maxLength": 0 }
                ],
                "description": "HPO terms for phenotype annotation (optional)",
                "help_text": "Human Phenotype Ontology terms in the format HP:0000000. Multiple terms should be separated by semicolons. Leave empty if no HPO terms are available."
            }
        },
        "required": ["sample_id"],
        "anyOf": [
            { "required": ["ubam"], "not": { "properties": { "ubam": { "maxLength": 0 } } } },
            { "required": ["fastq"], "not": { "properties": { "fastq": { "maxLength": 0 } } } },
            { "required": ["bam"], "not": { "properties": { "bam": { "maxLength": 0 } } } }
        ],
        "additionalProperties": false
    }
}
