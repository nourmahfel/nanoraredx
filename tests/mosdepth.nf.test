nextflow_workflow {

    name "Test Subworkflow MOSDEPTH"
    script "../subworkflows/local/mosdepth.nf"
    workflow "mosdepth"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "mosdepth"
    tag "coverage"

    test("Coverage analysis with Mosdepth") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file('${projectDir}/assets/test_data/test.bam', checkIfExists: true),
                    file('${projectDir}/assets/test_data/test.bam.bai', checkIfExists: true),
                    []
                ])

                input[1] = [[],[]]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.summary_txt != null },
                { assert workflow.out.regions_bed != null },
                { assert workflow.out.versions != null }
            )
        }
    }

    test("Coverage analysis - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file('${projectDir}/assets/test_data/test.bam', checkIfExists: true),
                    file('${projectDir}/assets/test_data/test.bam.bai', checkIfExists: true),
                    []
                ])

                input[1] = [[],[]]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.summary_txt != null },
                { assert workflow.out.regions_bed != null }
            )
        }
    }
}
