/*
========================================================================================
    Test-specific Nextflow configuration for alignment subworkflow tests
========================================================================================
*/

// Test parameters
params {
    // Test data paths - using your existing test data structure
    modules_testdata_base_path = "${projectDir}/assets/test_data/"

    // Basic pipeline parameters for testing
    outdir = "test_results"

    // Reference files for testing
    fasta_file = "${projectDir}/assets/test_data/genome_22/genome_22.fasta"

    // Alignment-specific parameters for testing
    align_with_fastq = true   // Enable for alignment subworkflow testing
    use_winnowmap = false     // Test minimap2 by default

    // Disable other pipeline components for focused testing
    align_with_bam = false
    generate_bam_stats = false
    generate_coverage = false
    sv = false
    snv = false
    cnv = false
    str = false
    phase = false
    qc = false
    methyl = false
    consensuSV = false

    // Test data settings
    use_test_data = true
}

// Process-specific configurations for alignment
process {
    withName: 'MINIMAP2_INDEX' {
        ext.args = '-x map-ont'
        cpus = 1
        memory = '2.GB'
        time = '30.min'
    }
    withName: 'MINIMAP2_ALIGN' {
        ext.args = '-ax map-ont'
        cpus = 2
        memory = '4.GB'
        time = '1.h'
    }
    withName: 'WINNOWMAP_ALIGN' {
        ext.args = '-ax map-ont'
        cpus = 2
        memory = '4.GB'
        time = '1.h'
    }
}

docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

// Executor settings for testing
executor {
    name = 'local'
    cpus = 4
    memory = '10.GB'
}
